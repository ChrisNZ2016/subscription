# Client (Vite — exposed to browser)
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
VITE_SHOPIFY_API_VERSION=2025-01
VITE_SAMPLE_PRODUCT_HANDLE=sample-2kg
VITE_SUBSCRIPTION_PRODUCT_HANDLE=kibble-pack
VITE_ADDON_HANDLES=poop-bags,dog-treats
VITE_MIXPANEL_TOKEN=your-mixpanel-token
# Meta pixel — same ID as the Facebook & Instagram Shopify app
VITE_META_PIXEL_ID=194052245

# Server (Vercel only — never VITE_ prefix)
MIXPANEL_TOKEN=your-mixpanel-token
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret
META_PIXEL_ID=194052245
META_CAPI_ACCESS_TOKEN=your-meta-capi-access-token

# Sample-to-subscription webhook (orders/create → RecurPay + cancel Shopify contract)
SHOPIFY_CLIENT_ID=your-dev-dashboard-client-id
SHOPIFY_CLIENT_SECRET=your-dev-dashboard-client-secret
SHOPIFY_SHOP=little-green-dog.myshopify.com
RECURPAY_ACCESS_TOKEN=rcpat_your-token
RECURPAY_API_BASE=https://little-green-dog.recurpay.com/admin/api/2024-07

# One-click subscription add-on (email/SMS links → Recurpay line item)
# LINK_SIGNING_SECRET and ADDON_LINK_SECRET: openssl rand -base64 32
LINK_SIGNING_SECRET=generate-a-long-random-secret
ADDON_LINK_SECRET=generate-a-different-long-random-secret
ADDON_PUBLIC_BASE_URL=https://lp.littlegreendog.co.nz
# JSON array of campaigns. Omit to use the built-in poop-bag 60/120 packs.
# isOnetime: false = stays on every delivery; true = this next order only.
# ADDON_CAMPAIGNS=[{"slug":"poop-bags-60","variantId":10597438849060,"quantity":1,"isOnetime":false,"label":"Compostable poop bags (60-pack)","ttlDays":14},{"slug":"poop-bags-120","variantId":10597447106596,"quantity":1,"isOnetime":false,"label":"Compostable poop bags (120-pack)","ttlDays":14}]
# Optional. When set, POST /api/addon-link writes recurpay_subscription_id + recurpay_link_sig to the Klaviyo profile.
KLAVIYO_API_KEY=pk_your-private-key
